{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis-ai-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      // If 1001 is already used by another rate limit in your Cloudflare account, choose another unused positive integer.
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
