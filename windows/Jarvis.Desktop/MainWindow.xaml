<Window x:Class="Jarvis.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JARVIS AI V4" Height="820" Width="1080"
        MinHeight="620" MinWidth="780"
        Background="#07111F" Foreground="#F3F7FC"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="J.A.R.V.I.S" FontSize="26" FontWeight="SemiBold" Foreground="#61E6FF" />
                <TextBlock Text="V4 · Shared AI" Foreground="#9BB0C5" />
            </StackPanel>
            <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="150" Height="36"
                      VerticalAlignment="Center" SelectionChanged="LanguageBox_SelectionChanged"
                      SelectedIndex="0">
                <ComboBoxItem Content="English" Tag="en-US" />
                <ComboBoxItem Content="Urdu" Tag="ur-PK" />
                <ComboBoxItem Content="Hindi" Tag="hi-IN" />
            </ComboBox>
        </Grid>

        <Border Grid.Row="1" Background="#0C1928" CornerRadius="16" Padding="16">
            <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#142235" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Speaker}" Foreground="#61E6FF"
                                               FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                               Margin="0,6,0,0" FontSize="15" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="4,12"
                   Foreground="#9BB0C5" Text="Configure your HTTPS backend and access token to begin." />

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="EndpointBox" Grid.Column="0" Height="38" Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         ToolTip="HTTPS Worker origin, without /v1/chat" />
                <PasswordBox x:Name="TokenBox" Grid.Column="1" Height="38" Margin="0,0,8,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Short-lived identity access token" />
                <Button Grid.Column="2" Content="Save access" Click="SaveAccess_Click"
                        Padding="14,6" Margin="0,0,8,0" />
                <CheckBox x:Name="SpeakRepliesBox" Grid.Column="3" Content="Speak replies"
                          IsChecked="True" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PromptBox" Grid.Column="0" Height="54" Padding="12"
                         VerticalContentAlignment="Center" AcceptsReturn="False"
                         KeyDown="PromptBox_KeyDown"
                         ToolTip="Type a message and press Enter" />
                <Button Grid.Column="1" Content="Mic" Click="Listen_Click"
                        Padding="20,8" Margin="8,0" />
                <Button x:Name="SendButton" Grid.Column="2" Content="Send"
                        Click="Send_Click" Padding="24,8" />
            </Grid>
        </Grid>
    </Grid>
</Window>
