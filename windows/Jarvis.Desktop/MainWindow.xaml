<Window x:Class="Jarvis.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JARVIS AI V4" Height="900" Width="1240"
        MinHeight="700" MinWidth="820"
        Background="#030A16" Foreground="#E8F7FF"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Neon" Color="#20DFFF" />
        <SolidColorBrush x:Key="ElectricBlue" Color="#168DFF" />
        <SolidColorBrush x:Key="Panel" Color="#D9081B31" />
        <SolidColorBrush x:Key="Muted" Color="#91B7D7" />
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8F7FF" />
            <Setter Property="Background" Value="#C9081B31" />
            <Setter Property="BorderBrush" Value="#9920DFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF20DFFF" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EF0D2A4A" />
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF20DFFF" BlurRadius="16" ShadowDepth="0" Opacity="0.55" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NeonTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8F7FF" />
            <Setter Property="CaretBrush" Value="#20DFFF" />
            <Setter Property="Background" Value="#D9081B31" />
            <Setter Property="BorderBrush" Value="#CC168DFF" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="ShortcutButton" TargetType="Button" BasedOn="{StaticResource NeonButton}">
            <Setter Property="MinWidth" Value="138" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Margin" Value="5,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2.1*" />
            <RowDefinition Height="1.05*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="☰" Style="{StaticResource NeonButton}" FontSize="22" Padding="12,3"
                    Click="Settings_Click" AutomationProperties.Name="Open JARVIS settings" />
            <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                <TextBlock Text="J.A.R.V.I.S" FontSize="31" FontWeight="Light" Foreground="{StaticResource Neon}" />
                <TextBlock Text="V4 · SHARED AI" FontSize="11" Foreground="{StaticResource Muted}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StopVoiceButton" Content="◼  Stop voice" Style="{StaticResource NeonButton}"
                        Click="StopVoice_Click" Margin="0,0,12,0" IsEnabled="False" />
                <ComboBox x:Name="LanguageBox" Width="142" Height="36"
                          SelectionChanged="LanguageBox_SelectionChanged" SelectedIndex="0"
                          Background="#101D2D" Foreground="#E8F7FF" BorderBrush="#66168DFF">
                    <ComboBoxItem Content="English" Tag="en-US" />
                    <ComboBoxItem Content="اردو" Tag="ur-PK" />
                    <ComboBoxItem Content="हिन्दी" Tag="hi-IN" />
                </ComboBox>
                <Button Content="⚙" Style="{StaticResource NeonButton}" FontSize="20" Padding="10,3"
                        Click="Settings_Click" Margin="10,0,0,0" AutomationProperties.Name="Settings" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#B9081B31" BorderBrush="#66168DFF" BorderThickness="1"
                CornerRadius="14" Padding="12,7" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" Foreground="#83E9FF" Text="Configure your HTTPS backend and access token to begin."
                       TextWrapping="Wrap" FontSize="13" />
        </Border>

        <Border x:Name="SettingsPanel" Grid.Row="2" Panel.ZIndex="4" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Width="410" Margin="0,0,0,8"
                Background="#F0081728" BorderBrush="#FF20DFFF" BorderThickness="1.5"
                CornerRadius="18" Padding="18">
            <StackPanel>
                <TextBlock Text="SECURE CONNECTION" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Neon}" />
                <TextBlock Text="Use the HTTPS Worker origin and a short-lived access token from your OIDC provider."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,10" />
                <TextBox x:Name="EndpointBox" Height="38" Margin="0,0,0,8" Style="{StaticResource NeonTextBox}"
                         ToolTip="HTTPS Worker origin, without /v1/chat" />
                <PasswordBox x:Name="TokenBox" Height="38" Margin="0,0,0,8" Padding="12,8"
                             Background="#D9081B31" Foreground="#E8F7FF" BorderBrush="#CC168DFF"
                             ToolTip="Short-lived identity access token" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="SpeakRepliesBox" Content="Speak replies" IsChecked="True"
                              VerticalAlignment="Center" Foreground="#D7F2FF" Margin="0,0,12,0" />
                    <Button Content="Save access" Style="{StaticResource NeonButton}" Click="SaveAccess_Click" />
                    <Button Content="Close" Style="{StaticResource NeonButton}" Click="Settings_Click" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="Tokens are protected with Windows DPAPI for this user. Provider secrets never belong in the client."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,2,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="2.45*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Canvas Grid.ColumnSpan="3" ClipToBounds="True" IsHitTestVisible="False" Opacity="0.55">
                    <Path Stroke="#33168DFF" StrokeThickness="1.1" Data="M0,170 L90,170 120,140 215,140 255,170 340,170" />
                    <Path Stroke="#4420DFFF" StrokeThickness="1.2" Data="M0,205 L78,205 112,235 190,235 230,205 300,205" />
                    <Path Stroke="#33168DFF" StrokeThickness="1.1" Data="M700,170 L790,170 825,140 920,140 960,170 1050,170" />
                    <Path Stroke="#4420DFFF" StrokeThickness="1.2" Data="M740,205 L820,205 854,235 930,235 975,205 1050,205" />
                </Canvas>
                <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Width="250" Height="250" AutomationProperties.Name="JARVIS AI core">
                    <Ellipse Fill="#28168DFF" Opacity="0.45">
                        <Ellipse.Effect>
                            <BlurEffect Radius="38" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Margin="4" Stroke="#7720DFFF" StrokeThickness="1" />
                    <Ellipse Margin="15" Stroke="#AA168DFF" StrokeThickness="1.5" />
                    <Ellipse Margin="28" Stroke="#FF20DFFF" StrokeThickness="3">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#FF20DFFF" BlurRadius="20" ShadowDepth="0" Opacity="0.85" />
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="OrbRotation" CenterX="112" CenterY="112" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="OrbRotation" Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <Ellipse Margin="45" Stroke="#9920DFFF" StrokeThickness="1" />
                    <Ellipse Margin="61" Fill="#E8051020" Stroke="#66168DFF" StrokeThickness="1" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="JARVIS" FontSize="48" FontWeight="Light" Foreground="{StaticResource Neon}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="AI PERSONAL ASSISTANT" FontSize="13" Foreground="#83E9FF"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="CoreStateText" Text="IDLE" FontSize="10" Foreground="#52F29B"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Canvas x:Name="WaveformCanvas" Grid.Row="1" Height="48" Margin="18,0">
                <Canvas.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="WaveformPulse" Storyboard.TargetProperty="(Canvas.Left)"
                                                 From="-120" To="1000" Duration="0:0:3.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Canvas.Triggers>
                <Path Stroke="#6630DFFF" StrokeThickness="1" Data="M0,23 L1200,23" />
                <Rectangle x:Name="WaveformPulse" Width="95" Height="4" RadiusX="2" RadiusY="2"
                           Fill="#FF20DFFF" Canvas.Left="-120" Canvas.Top="21">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#FF20DFFF" BlurRadius="14" ShadowDepth="0" />
                    </Rectangle.Effect>
                </Rectangle>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="· 〰 ı | ı ǀ ı | ı 〰 ·" Foreground="#CC20DFFF" FontSize="28"
                               Canvas.Left="10" Canvas.Top="2" />
                </StackPanel>
            </Canvas>

            <Border Grid.Row="2" HorizontalAlignment="Center" MinWidth="330" Background="#B9081B31"
                    BorderBrush="#CC20DFFF" BorderThickness="1" CornerRadius="22" Padding="22,8" Margin="0,4,0,9">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#52F29B" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#FF52F29B" BlurRadius="12" ShadowDepth="0" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="CoreStatusText" Text="Ready to help you…" Foreground="#E8F7FF"
                               FontSize="17" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,9">
                    <Button Content="▤&#x0a;Chat with JARVIS" Style="{StaticResource ShortcutButton}" Click="ChatShortcut_Click" />
                    <Button Content="◉&#x0a;Voice Assistant" Style="{StaticResource ShortcutButton}" Click="Listen_Click" />
                    <Button Content="◌&#x0a;WhatsApp Announcements" Style="{StaticResource ShortcutButton}" Click="AndroidFeature_Click" />
                    <Button Content="☎&#x0a;Call Announcements" Style="{StaticResource ShortcutButton}" Click="AndroidFeature_Click" />
                </StackPanel>
                <Border Background="#B9081B31" BorderBrush="#77168DFF" BorderThickness="1"
                        CornerRadius="15" Padding="13,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="4" Text="SYSTEM STATUS" Foreground="{StaticResource Neon}"
                                   FontWeight="SemiBold" FontSize="12" />
                        <StackPanel Grid.Row="1" Margin="0,5,0,0">
                            <TextBlock Text="Backend" Foreground="{StaticResource Muted}" FontSize="10" />
                            <TextBlock x:Name="BackendStateText" Text="Not checked" Foreground="#D5E9F8" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,5,0,0">
                            <TextBlock Text="Microphone" Foreground="{StaticResource Muted}" FontSize="10" />
                            <TextBlock x:Name="MicrophoneStateText" Text="Not tested" Foreground="#D5E9F8" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="6,5,0,0">
                            <TextBlock Text="Language" Foreground="{StaticResource Muted}" FontSize="10" />
                            <TextBlock x:Name="SelectedLanguageText" Text="English" Foreground="#D5E9F8" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="6,5,0,0">
                            <TextBlock Text="Network" Foreground="{StaticResource Muted}" FontSize="10" />
                            <TextBlock x:Name="NetworkStateText" Text="Checking…" Foreground="#D5E9F8" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="#A9071425" BorderBrush="#55168DFF" BorderThickness="1"
                CornerRadius="15" Padding="12" Margin="0,0,0,9">
            <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#D9102740" BorderBrush="#66168DFF" BorderThickness="0,0,0,1"
                                    CornerRadius="10" Padding="13" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Speaker}" Foreground="#20DFFF"
                                               FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                               Margin="0,5,0,0" FontSize="14" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,0,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PromptBox" Grid.Column="0" Height="58" Style="{StaticResource NeonTextBox}"
                     VerticalContentAlignment="Center" AcceptsReturn="False" KeyDown="PromptBox_KeyDown"
                     ToolTip="Type a message and press Enter" />
            <Button Grid.Column="1" Content="🎙" FontSize="19" Width="58" Height="54" Padding="5"
                    Style="{StaticResource NeonButton}" Click="Listen_Click" Margin="9,0"
                    AutomationProperties.Name="Start or stop microphone recognition" />
            <Button x:Name="SendButton" Grid.Column="2" Content="➤  Send" FontSize="16"
                    Style="{StaticResource NeonButton}" Click="Send_Click" Padding="22,10" />
        </Grid>

        <Canvas Grid.Row="5" Height="26" ClipToBounds="True" Margin="0,0,0,2">
            <Canvas.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="CircuitPulse" Storyboard.TargetProperty="(Canvas.Left)"
                                             From="-10" To="1200" Duration="0:0:3.4" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Canvas.Triggers>
            <Path Stroke="#AA168DFF" StrokeThickness="2" Data="M0,7 L22,19 210,19 236,25 360,25 382,15 590,15 610,8 650,8 670,15 875,15 895,25 1010,25 1030,19 1200,19 1220,7">
                <Path.Effect>
                    <DropShadowEffect Color="#FF20DFFF" BlurRadius="9" ShadowDepth="0" Opacity="0.65" />
                </Path.Effect>
            </Path>
            <Path Stroke="#FF20DFFF" StrokeThickness="1" Data="M0,5 L22,17 210,17 236,23 360,23 382,13 590,13 610,6 650,6 670,13 875,13 895,23 1010,23 1030,17 1200,17 1220,5" />
            <Ellipse x:Name="CircuitPulse" Width="7" Height="7" Fill="White" Canvas.Left="-10" Canvas.Top="10">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FF20DFFF" BlurRadius="14" ShadowDepth="0" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>
    </Grid>
</Window>
